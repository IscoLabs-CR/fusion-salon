NEXT_PUBLIC_SUPABASE_URL=https://__PROJECT_REF__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=__SUPABASE_ANON_KEY__

# Web Push (VAPID) — clave PÚBLICA. Segura de exponer: viaja al navegador para
# suscribir al barbero. Generá el par con:  npx web-push generate-vapid-keys
# (la clave PRIVADA NO va acá: se guarda en app_config o como secret de la
# Edge Function — ver SKILL.md PASO 2). En Vercel agregá esta misma var.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=__VAPID_PUBLIC_KEY__
